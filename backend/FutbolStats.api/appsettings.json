{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=FutbolStatsDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "FutbolStats.Api",
    "Audience": "FutbolStats.Client",
    "SecretKey": "CAMBIAR_ESTA_CLAVE_EN_PRODUCCION_1234567890",
    "ExpirationMinutes": 120,
    "RefreshExpirationDays": 14
  },
  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "Model": "gemini-3.6-flash",
    "FallbackModels": [
      "gemini-3.7-flash",
      "gemini-flash-latest",
      "gemini-3.5-flash",
      "gemini-3.1-flash-lite"
    ],
    "TimeoutSeconds": 90
  },
  "MatchRules": {
    "MaxCambiosPorPartido": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
